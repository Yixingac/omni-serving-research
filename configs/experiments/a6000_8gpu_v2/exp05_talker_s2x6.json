{
 "runtime_profile": "unicorn",
 "hardware_label": "a6000x8",
 "seed": 0,
 "assets": "synthetic-v1",
 "experiment_id": "exp05_talker_s2x6",
 "description": "实验 5（GPU 为什么会等待）第一次补测：一个服务：2 个 thinker（pipeline）副本 + 6 个 talker 副本，code2wav 单独进程、与 talker 同卡。W3b 闭环并发 128：先预热一波（128 个请求），再跑三段，每段 384 个请求（另加 128 个预热）：只记事件 → 第 12 秒起开 3 秒 torch profiler → 再只记事件（看先后顺序的影响）。看高负载时 talker 卡被什么卡住：talker 的 CPU 开销，还是 code2wav 的计算。",
 "restart_dead_servers": true,
 "max_server_restarts": 4,
 "servers": [
  {
   "name": "s0",
   "model": "minicpm_o_4_5",
   "gpus": [
    0,
    1,
    2,
    3,
    4,
    5,
    6,
    7
   ],
   "args": [
    "--config",
    "{research_repo}/configs/models/minicpm_o_4_5_v2_s2x6.yaml"
   ],
   "ready_timeout_s": 2400
  }
 ],
 "phases": [
  {
   "kind": "smoke",
   "name": "smoke_w3b",
   "workload": "configs/workloads/w3b_text_speech.json",
   "requests": 2
  },
  {
   "kind": "closed_loop",
   "name": "w3b_warm_c128",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    128
   ],
   "requests_per_level": 128,
   "requests_per_concurrency": 1,
   "warmup": 0
  },
  {
   "kind": "closed_loop",
   "name": "w3b_base_c128",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    128
   ],
   "requests_per_level": 384,
   "requests_per_concurrency": 1,
   "warmup": 128,
   "server_events": true
  },
  {
   "kind": "closed_loop",
   "name": "w3b_prof_c128",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    128
   ],
   "requests_per_level": 384,
   "requests_per_concurrency": 1,
   "warmup": 128,
   "torch_profile_window": {
    "start_after_s": 12,
    "duration_s": 3
   }
  },
  {
   "kind": "closed_loop",
   "name": "w3b_base2_c128",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    128
   ],
   "requests_per_level": 384,
   "requests_per_concurrency": 1,
   "warmup": 128,
   "server_events": true
  }
 ]
}
