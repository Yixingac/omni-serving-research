   "concurrency": [
    8
   ],
   "requests_per_level": 32,
   "requests_per_concurrency": 1,
   "warmup": 8,
   "server_events": true
  },
  {
   "kind": "closed_loop",
   "name": "w3b_prof_c8",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    8
   ],
   "requests_per_level": 32,
   "requests_per_concurrency": 1,
   "warmup": 8,
   "torch_profile": true
  },
  {
   "kind": "closed_loop",
   "name": "w3b_base_c64",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    64
   ],
