{
 "runtime_profile": "unicorn",
 "hardware_label": "a6000x8",
 "seed": 0,
 "assets": "synthetic-v1",
 "experiment_id": "exp01_prof_s2x6",
 "description": "实验 1（8 张 GPU 在做什么）：一个服务：2 个 thinker（pipeline）副本 + 6 个 talker 副本，code2wav 单独进程、与 talker 同卡。W3b 闭环并发 8（32 个请求）和 64（64 个请求），每个并发先只开事件记录跑一遍，再开 torch profiler（CPU 操作、CUDA 调用和 GPU kernel）跑一遍，用来画每张 GPU 的工作时间线，并量出 profiler 本身的开销。",
 "restart_dead_servers": true,
