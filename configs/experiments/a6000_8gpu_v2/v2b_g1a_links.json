{
 "runtime_profile": "unicorn",
 "hardware_label": "a6000x8",
 "seed": 0,
 "assets": "synthetic-v1",
 "experiment_id": "v2b_g1a_links",
 "description": "第二批 G1：4 个 2 卡拆分服务（thinker 卡 → talker 卡，code2wav 单独进程）同时运行，卡对的连接分别是 node（GPU 0→2）、pix（GPU 1→3）、nv4（GPU 4→5）、nv4（GPU 6→7）；客户端轮流分配请求，每个服务承受相同的负载。W3b 闭环并发 16、32，开环 6、10、13、15 请求/秒（合计），开事件记录，按服务比较延迟和跨卡传递时间。",
 "restart_dead_servers": true,
 "max_server_restarts": 4,
 "servers": [
  {
   "name": "g_node",
   "model": "minicpm_o_4_5",
   "gpus": [
    0,
    2
   ],
   "args": [
    "--talker.gpu",
    "1",
    "--code2wav.gpu",
    "1",
    "--code2wav.process",
    "code2wav"
   ],
   "ready_timeout_s": 2400
  },
  {
   "name": "g_pix",
   "model": "minicpm_o_4_5",
   "gpus": [
    1,
    3
   ],
   "args": [
    "--talker.gpu",
    "1",
    "--code2wav.gpu",
    "1",
    "--code2wav.process",
    "code2wav"
   ],
   "ready_timeout_s": 2400
  },
  {
   "name": "g_nv4a",
   "model": "minicpm_o_4_5",
   "gpus": [
    4,
    5
   ],
   "args": [
    "--talker.gpu",
    "1",
    "--code2wav.gpu",
    "1",
    "--code2wav.process",
    "code2wav"
   ],
   "ready_timeout_s": 2400
  },
  {
   "name": "g_nv4b",
   "model": "minicpm_o_4_5",
   "gpus": [
    6,
    7
   ],
   "args": [
    "--talker.gpu",
    "1",
    "--code2wav.gpu",
    "1",
    "--code2wav.process",
    "code2wav"
   ],
   "ready_timeout_s": 2400
  }
 ],
 "phases": [
  {
   "kind": "smoke",
   "name": "smoke_w3b",
   "workload": "configs/workloads/w3b_text_speech.json",
   "requests": 2
  },
  {
   "kind": "closed_loop",
   "name": "w3b_closed",
   "workload": "configs/workloads/w3b_text_speech.json",
   "concurrency": [
    16,
    32
   ],
   "requests_per_level": 96,
   "requests_per_concurrency": 3,
   "server_events": true
  },
  {
   "kind": "open_loop",
   "name": "w3b_open_abs",
   "workload": "configs/workloads/w3b_text_speech.json",
   "rates_rps": [
    6,
    10,
    13,
    15
   ],
   "duration_per_rate_s": 120,
   "min_requests_per_rate": 96,
   "max_error_rate": 0.2,
   "server_events": true
  }
 ],
 "routing": "round_robin"
}
