{
  "runtime_profile": "unicorn",
  "hardware_label": "a6000x2",
  "seed": 0,
  "experiment_id": "x7e_minicpm_2gpu_disagg_events",
  "description": "x7b（thinker 在 GPU 0，talker+code2wav 在 GPU 1）开启服务端请求事件记录，W3b 并发 4–32。检验第 7 节的推测：拆分是否消除了 thinker 与 talker 的同卡争用，以及并发 32 时瓶颈在哪个阶段。",
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5",
      "gpus": [
        0,
        1
      ],
      "args": [
        "--talker.gpu",
        "1",
        "--code2wav.gpu",
        "1"
      ],
      "ready_timeout_s": 2400
    }
  ],
  "assets": "synthetic-v1",
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "requests": 2
    },
    {
      "kind": "closed_loop",
      "name": "w3b_events",
      "workload": "configs/workloads/w3b_text_speech.json",
      "concurrency": [
        4,
        8,
        16,
        32
      ],
      "requests_per_level": 48,
      "server_events": true,
      "stop_if_p50_e2e_above_s": 90
    }
  ]
}
