{
  "runtime_profile": "unicorn",
  "hardware_label": "a6000x2",
  "seed": 0,
  "experiment_id": "x7c_minicpm_2gpu_talker_replica",
  "description": "2 卡预算之三：thinker 一份在 GPU 0，talker+code2wav 进程复制两份（GPU 0、GPU 1），只复制语音生成阶段。 另外用 x5 的 Agent trace 做依赖感知回放，在 Agent 负载下比较放置（上游的放置对比只用了固定 TTS 负载）。",
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5",
      "gpus": [
        0,
        1
      ],
      "args": [
        "--config",
        "{research_repo}/configs/models/minicpm_o_4_5_talker_replica2.yaml"
      ],
      "ready_timeout_s": 2400
    }
  ],
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "requests": 2
    },
    {
      "kind": "closed_loop",
      "name": "w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "concurrency": [
        2,
        4,
        8,
        16,
        32
      ],
      "requests_per_level": 48,
      "stop_if_p50_e2e_above_s": 90
    },
    {
      "kind": "replay",
      "name": "replay_voice_dep_x2",
      "trace": "latest/x5_minicpm_agents/raw/agent_trace_agents_voice_c4.jsonl",
      "mode": "dependency",
      "speed": 1.0,
      "session_copies": 2
    },
    {
      "kind": "replay",
      "name": "replay_text_dep_x4",
      "trace": "latest/x5_minicpm_agents/raw/agent_trace_agents_text_c4.jsonl",
      "mode": "dependency",
      "speed": 1.0,
      "session_copies": 4,
      "session_arrival": "poisson:0.5"
    }
  ],
  "assets": "synthetic-v1"
}
