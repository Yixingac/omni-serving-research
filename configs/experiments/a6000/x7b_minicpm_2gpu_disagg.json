{
  "runtime_profile": "unicorn",
  "hardware_label": "a6000x2",
  "seed": 0,
  "experiment_id": "x7b_minicpm_2gpu_disagg",
  "description": "2 卡预算之二：拆分放置，thinker 与编码器在 GPU 0，talker 与 code2wav 在 GPU 1（一个服务）。",
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5",
      "gpus": [
        0,
        1
      ],
      "args": [
        "--talker.gpu",
        "1",
        "--code2wav.gpu",
        "1"
      ],
      "ready_timeout_s": 2400
    }
  ],
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "requests": 2
    },
    {
      "kind": "closed_loop",
      "name": "w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "concurrency": [
        2,
        4,
        8,
        16,
        32
      ],
      "requests_per_level": 48,
      "stop_if_p50_e2e_above_s": 90
    }
  ]
}
