{
  "runtime_profile": "spark",
  "hardware_label": "spark_gb10",
  "seed": 0,
  "experiment_id": "s2_minicpm_speech_smoke",
  "description": "Spark GB10 功能验证：MiniCPM-o 4.5 默认语音流水线能否在 GB10 上生成语音；同时检查服务端请求事件记录。",
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5_spark",
      "gpus": [
        0
      ],
      "ready_timeout_s": 3600
    }
  ],
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "requests": 2
    },
    {
      "kind": "closed_loop",
      "name": "w3b_small",
      "workload": "configs/workloads/w3b_text_speech.json",
      "concurrency": [
        1,
        2
      ],
      "requests_per_level": 4,
      "server_events": true
    },
    {
      "kind": "agent",
      "name": "agents_text_small",
      "sessions": 4,
      "concurrency": 2,
      "seed": 2,
      "agent": {
        "max_steps": 5
      }
    }
  ]
}
