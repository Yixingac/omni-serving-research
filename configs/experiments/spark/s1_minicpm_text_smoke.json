{
  "runtime_profile": "spark",
  "hardware_label": "spark_gb10",
  "seed": 0,
  "experiment_id": "s1_minicpm_text_smoke",
  "description": "Spark GB10 功能验证：MiniCPM-o 4.5 --text-only 能否启动并正确回答；少量并发只用来检查客户端与服务端，数字不与 A6000 比较。",
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5_spark",
      "gpus": [
        0
      ],
      "args": [
        "--text-only"
      ],
      "ready_timeout_s": 3600
    }
  ],
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w1",
      "workload": "configs/workloads/w1_text_chat.json",
      "requests": 3
    },
    {
      "kind": "closed_loop",
      "name": "w1_small",
      "workload": "configs/workloads/w1_text_chat.json",
      "concurrency": [
        1,
        4
      ],
      "requests_per_level": 8,
      "server_events": true
    }
  ]
}
