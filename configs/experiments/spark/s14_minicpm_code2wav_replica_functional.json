{
  "runtime_profile": "spark",
  "hardware_label": "spark_gb10",
  "seed": 0,
  "experiment_id": "s14_minicpm_code2wav_replica_functional",
  "description": "功能测试，不是性能实验。plan v2 的 S 布局把 code2wav 放在自己的进程里，并与 talker 一样复制多份（避开第 17 节的崩溃）。离线检查通过，但运行时还没验证过：talker 副本能否把结果交给单独进程的 code2wav 副本。这里在 Spark 上把 talker 和 code2wav 各复制两份、都放在 GPU 0，检查服务能否启动、语音请求能否完成、两个 code2wav 副本是否都接到请求。",
  "restart_dead_servers": false,
  "servers": [
    {
      "name": "s0",
      "model": "minicpm_o_4_5_spark",
      "gpus": [
        0
      ],
      "ready_timeout_s": 3600,
      "args": [
        "--config",
        "{research_repo}/configs/models/minicpm_o_4_5_c2w_replica2_samegpu.yaml"
      ]
    }
  ],
  "phases": [
    {
      "kind": "smoke",
      "name": "smoke_w3b",
      "workload": "configs/workloads/w3b_text_speech.json",
      "requests": 2
    },
    {
      "kind": "closed_loop",
      "name": "w3b_small",
      "workload": "configs/workloads/w3b_text_speech.json",
      "concurrency": [
        1,
        4
      ],
      "requests_per_level": 8,
      "server_events": true
    }
  ]
}
