      ],
      "args": [
        "--model-name",
        "qwen3-omni",
        "--thinker.tp_size",
        "2",
        "--thinker.gpu",
        "[0, 1]",
        "--talker_ar.gpu",
        "2",
        "--thinker.engine.disable_custom_all_reduce",
        "true"
      ],
      "ready_timeout_s": 3600,
      "env": {
