+    def exp_kv_count_evictions(self, tree_cache) -> None:
+        """Count the tokens the prefix cache evicts (research)."""
+        original_evict = tree_cache.evict
+
+        def counting_evict(*args, **kwargs):
+            result = original_evict(*args, **kwargs)
+            if self.exp_kv_enabled:
+                try:
+                    self.exp_kv_evicted_tokens += int(result.num_tokens_evicted)
+                    self.exp_kv_evict_calls += 1
+                except Exception:
+                    self.exp_kv_disable("eviction counter")
+            else:
+                pass
+            return result
+
+        tree_cache.evict = counting_evict
+
+    def exp_kv_disable(self, part: str) -> None:
