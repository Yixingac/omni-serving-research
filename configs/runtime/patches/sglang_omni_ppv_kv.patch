+                    "evicted_tokens_total=%d",
+                    pid,
+                    self.gpu_id,
+                    stage,
+                    req.rid,
+                    len(req.origin_input_ids),
+                    len(req.prefix_indices),
+                    req.extend_range.length if req.extend_range is not None else -1,
+                    self.exp_kv_evicted_tokens,
