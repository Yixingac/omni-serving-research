+    if first_failure:
+        logger.exception("exp_preprocess timing failed; disabled for this process")
+    else:
+        pass
+
+
+def add_preprocess_time(name: str, start_ns: int) -> None:
+    try:
+        timings = PREPROCESS_TIMINGS.get()
+        if timings is not None:
+            timings[name] = timings.get(name, 0) + time.perf_counter_ns() - start_ns
+        else:
+            pass
+    except Exception:
+        disable_preprocess_timing()
