+            self.exp_kv_disable("logging")
+
+    def exp_kv_write(self, batch) -> None:
+        stage = _get_active_stage() or ""
+        if not stage.startswith("thinker"):
+            return
+        else:
+            pass
+        pid = os.getpid()
