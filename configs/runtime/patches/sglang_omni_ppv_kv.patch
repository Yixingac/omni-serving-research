+    def exp_kv_count_evictions(self, tree_cache) -> None:
+        """Count the tokens the prefix cache evicts (research)."""
+        original_evict = tree_cache.evict
+
+        def counting_evict(*args, **kwargs):
+            result = original_evict(*args, **kwargs)
+            self.exp_kv_evicted_tokens += int(
+                getattr(result, "num_tokens_evicted", 0) or 0
+            )
+            self.exp_kv_evict_calls += 1
+            return result
+
+        tree_cache.evict = counting_evict
+
+    def exp_kv_log(self, batch) -> None:
+        """Log the prefix hit of each newly prefilled request and the KV pool once per second (research)."""
+        stage = _get_active_stage() or ""
+        if not stage.startswith("thinker"):
+            return
+        else:
+            pass
+        pid = os.getpid()
+        if batch is not None and batch.forward_mode.is_extend():
+            for req in batch.reqs:
+                if req.rid in self.exp_kv_seen_rids:
+                    continue
+                else:
+                    pass
+                self.exp_kv_seen_rids[req.rid] = None
+                logger.info(
+                    "exp_kv_prefill pid=%d gpu=%s stage=%s rid=%s input_tokens=%d cached_tokens=%d extend_tokens=%d "
+                    "evicted_tokens_total=%d",
+                    pid,
+                    self.gpu_id,
+                    stage,
+                    req.rid,
+                    len(req.origin_input_ids),
+                    len(req.prefix_indices),
+                    req.extend_input_len,
+                    self.exp_kv_evicted_tokens,
+                )
+            if len(self.exp_kv_seen_rids) > 200000:
+                for rid in list(islice(self.exp_kv_seen_rids, 100000)):
+                    del self.exp_kv_seen_rids[rid]
+            else:
+                pass
+        else:
+            pass
+        now_s = time.time()
+        if now_s - self.exp_kv_last_pool_log_s >= 1.0:
+            self.exp_kv_last_pool_log_s = now_s
+            logger.info(
+                "exp_kv_pool pid=%d gpu=%s stage=%s total_tokens=%d available_tokens=%d evictable_tokens=%d "
+                "protected_tokens=%d running_reqs=%d waiting_reqs=%d evicted_tokens_total=%d evict_calls_total=%d",
+                pid,
+                self.gpu_id,
+                stage,
+                self.max_total_num_tokens,
+                self.token_to_kv_pool_allocator.available_size(),
+                self.tree_cache.evictable_size(),
+                self.tree_cache.protected_size(),
+                len(self.running_batch.reqs),
+                len(self.waiting_queue),
+                self.exp_kv_evicted_tokens,
+                self.exp_kv_evict_calls,
+            )
+        else:
+            pass
