+                self.tree_cache.evictable_size(),
+                self.tree_cache.protected_size(),
+                len(self.running_batch.reqs),
+                len(self.waiting_queue),
+                self.exp_kv_evicted_tokens,
+                self.exp_kv_evict_calls,
+            )
