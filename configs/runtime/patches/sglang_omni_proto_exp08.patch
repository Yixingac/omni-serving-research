diff --git a/sglang_omni/profiler/exp_trace.py b/sglang_omni/profiler/exp_trace.py
new file mode 100644
index 000000000..e7c18d99c
--- /dev/null
+++ b/sglang_omni/profiler/exp_trace.py
@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in measurement points for research experiments on code2wav batching and thinker lookahead.
+
+Nothing here runs unless SGLANG_OMNI_EXP_TRACE names the part (comma list of c2w, thinker and digest;
+digest adds hashes of thinker hidden states and codec tokens for comparing runs).
+Events go through the request event recorder, so they are written only while request events are
+switched on, land in the same per-process JSONL files and use the same wall clock (time.time_ns).
+No call here synchronizes a CUDA stream: GPU spans come from CUDA events that are read after a
+synchronization the instrumented code already performs.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import os
+import threading
+import time
+from collections.abc import Iterator
+
+import torch
+
+from sglang_omni.profiler.event_recorder import emit, get_active_stage, get_recorder
+
+PARTS = frozenset(
+    part.strip()
+    for part in os.environ.get("SGLANG_OMNI_EXP_TRACE", "").split(",")
+    if part.strip()
+)
+THINKER_STEP_REQUEST_ID = "__thinker_step__"
+
+EventMetadata = dict[str, int | float | str | bool | list[int] | list[str]]
+
+thread_state = threading.local()
+
+
+def digest(values: torch.Tensor | list[int]) -> str:
+    """First 16 hex digits of SHA-256 over the dtype and raw bytes; bfloat16 is read as int16."""
+    tensor = values if isinstance(values, torch.Tensor) else torch.tensor(values, dtype=torch.int64)
+    tensor = tensor.detach().contiguous().cpu()
+    raw = tensor.view(torch.int16) if tensor.dtype == torch.bfloat16 else tensor
+    return hashlib.sha256(str(tensor.dtype).encode() + raw.numpy().tobytes()).hexdigest()[:16]
+
+
+def configured(part: str) -> bool:
+    """The part is switched on for this process, whether or not events are being recorded."""
+    return part in PARTS
+
+
+def active(part: str) -> bool:
+    """The part is switched on and request events are being recorded right now."""
+    return part in PARTS and get_recorder().is_active()
+
+
+def now_ns() -> int:
+    return time.time_ns()
+
+
+def stage_starts_with(prefix: str) -> bool:
+    return (get_active_stage() or "").startswith(prefix)
+
+
+def set_batch_id(batch_id: int | None) -> None:
+    """Bind the code2wav batch the scheduler thread is computing, for the vocode measurement."""
+    thread_state.batch_id = batch_id
+    thread_state.vocode_record = None
+
+
+def current_batch_id() -> int | None:
+    return getattr(thread_state, "batch_id", None)
+
+
+def set_vocode_record(record: EventMetadata | None) -> None:
+    thread_state.vocode_record = record
+
+
+def vocode_record() -> EventMetadata | None:
+    return getattr(thread_state, "vocode_record", None)
+
+
+def emit_for_requests(
+    request_ids: list[str],
+    event_name: str,
+    metadata: EventMetadata,
+    timestamp_ns: int,
+) -> None:
+    """One event per request, sharing the timestamp and metadata of their batch."""
+    for request_id in request_ids:
+        emit(
+            request_id=request_id,
+            stage=None,
+            event_name=event_name,
+            metadata=metadata,
+            timestamp_ns=timestamp_ns,
+        )
+
+
+@contextlib.contextmanager
