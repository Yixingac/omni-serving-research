diff --git a/sglang_omni/diag_gate.py b/sglang_omni/diag_gate.py
new file mode 100644
index 00000000..b497d886
--- /dev/null
+++ b/sglang_omni/diag_gate.py
@@ -0,0 +1,62 @@
+"""DIAG (omni-serving-research, 2026-11-12): keep the talker's and code2wav's GPU
+work from overlapping in time, to test whether the illegal memory access needs
+kernels of the two scheduler threads to run concurrently. Same process, same
+caching allocator, same graphs; only the overlap goes away. Off unless
+SGLANG_OMNI_DIAG_SERIALIZE_GPU=1."""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import threading
+from collections.abc import Iterator
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+# "1": the whole code2wav batch; "flow" or "hift": only that part of it.
+MODE = os.environ.get("SGLANG_OMNI_DIAG_SERIALIZE_GPU", "")
+ENABLED = MODE in ("1", "flow", "hift")
+_request = threading.Event()
+_parked = threading.Event()
+_done = threading.Event()
+_stats = {"batches": 0, "talker_parks": 0, "park_timeouts": 0}
+if ENABLED:
+    logger.warning("DIAG: talker and code2wav GPU work serialized (SGLANG_OMNI_DIAG_SERIALIZE_GPU=%s)", MODE)
+
+
+def talker_checkpoint() -> None:
+    """Called at the top of each talker loop iteration."""
+    if not ENABLED or not _request.is_set():
+        return
+    torch.cuda.synchronize()
+    _stats["talker_parks"] += 1
+    _parked.set()
+    _done.wait()
+    _parked.clear()
+
+
+@contextlib.contextmanager
+def code2wav_exclusive(part: str = "batch") -> Iterator[None]:
+    """Wraps one code2wav batch (or its flow / HiFT part); returns once that GPU work is done."""
+    if not ENABLED or part != ("batch" if MODE == "1" else MODE):
+        yield
+        return
+    _parked.clear()
+    _done.clear()
+    _request.set()
+    if not _parked.wait(timeout=2.0):
+        _stats["park_timeouts"] += 1
+        logger.warning("DIAG: talker did not park within 2 s; code2wav runs anyway %s", _stats)
+    torch.cuda.synchronize()
+    try:
+        yield
+    finally:
+        torch.cuda.synchronize()
+        _stats["batches"] += 1
+        _request.clear()
+        _done.set()
+        if _stats["batches"] % 100 == 0:
+            logger.info("DIAG serialize stats %s", _stats)
