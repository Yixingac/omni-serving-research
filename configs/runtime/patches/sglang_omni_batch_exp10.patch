+            elif should_generate_audio_output(data.stage_payload):
+                counts["speech"] += 1
+            elif getattr(data, "return_logprob", False):
+                counts["logprob"] += 1
+            else:
+                pass
+            sp = req.sampling_params
+            if (
+                sp.repetition_penalty != 1.0
+                or sp.presence_penalty != 0.0
+                or sp.frequency_penalty != 0.0
+                or sp.min_new_tokens > 0
+                or sp.sampling_seed is not None
+                or sp.logit_bias is not None
+                or sp.custom_params
+            ):
+                counts["sampling"] += 1
+            else:
+                pass
+        return counts
